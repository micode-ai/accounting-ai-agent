// Prisma Schema для AI Agent Бухгалтерии
// Database: PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// ENUMS
// ============================================

enum UserRole {
  user
  admin
}

enum SubscriptionPlan {
  free
  pro
}

enum SubscriptionStatus {
  active
  canceled
  past_due
  trialing
}

enum PaymentType {
  board_resolution
  employment
  mandate_contract
  work_contract
  dividend
}

enum ContractStatus {
  draft
  active
  terminated
  expired
}

enum AbsenceType {
  vacation
  sick_leave
  maternity
  unpaid
  other
}

enum KSeFSessionStatus {
  active
  expired
  terminated
  failed
}

enum KSeFInvoiceStatusEnum {
  pending
  sending
  sent
  accepted
  rejected
  completed
  failed
}

enum KSeFAdapterType {
  wfirma
  direct
}

enum AIMemoryCategory {
  user_preference
  business_fact
  frequent_entity
  workflow_pattern
}

enum AIMemorySource {
  explicit
  implicit
  tool_usage
}

enum OrgRole {
  admin
  member
}

enum OrgMembershipStatus {
  active
  pending
  rejected
}

enum ReferralStatus {
  pending
  converted
  revoked
}

// ============================================
// ORGANIZATIONS
// ============================================

model Organization {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   // original companyName
  nameNorm  String   @unique // lowercase trimmed for matching
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members            User[]
  conversations      AIConversation[]
  orgPromptShortcuts OrgPromptShortcut[]

  @@index([nameNorm])
  @@map("organizations")
}

// ============================================
// USER MANAGEMENT
// ============================================

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String?
  firstName    String?
  lastName     String?

  // OAuth providers
  googleId     String?  @unique
  githubId     String?  @unique

  // Organization membership
  organizationId     String?             @db.Uuid
  orgRole            OrgRole             @default(member)
  orgMembershipStatus OrgMembershipStatus @default(active)

  // User preferences
  locale       String   @default("en") // User's preferred language (en, pl)
  role         UserRole @default(user) // User role for access control
  isFirstLogin Boolean  @default(true) // Flag for showing welcome modal on first login

  // Subscription
  subscriptionPlan      SubscriptionPlan   @default(free)
  subscriptionStatus    SubscriptionStatus @default(active)
  stripeCustomerId      String?            @unique
  stripeSubscriptionId  String?            @unique
  subscriptionEndDate   DateTime?
  cancelAtPeriodEnd     Boolean            @default(false)

  // Referral program
  referralCode    String   @unique  // 8-char hex, generated in app layer
  referredByCode  String?           // referral code used during registration

  // AI usage limits (for Pro with app keys)
  aiMessagesUsed        Int                @default(0)
  aiMessagesLimit       Int                @default(500)
  aiMessagesResetAt     DateTime?

  // wFirma usage limits (for Free plan)
  wfirmaRequestsUsed    Int                @default(0)
  wfirmaRequestsLimit   Int                @default(30)
  wfirmaRequestsResetAt DateTime?

  // LLM key preference (for Pro users)
  useOwnLLMKey          Boolean            @default(false)

  // TTS usage tracking (stored in DB instead of LangSmith)
  ttsCharactersUsed     Int                @default(0)
  ttsCostUsd            Float              @default(0)

  // wFirma integration config
  wfirmaConfig Json?    @db.JsonB

  // Timestamps
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  deletedAt    DateTime?

  // Relations
  organization    Organization?      @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  conversations   AIConversation[]
  wfirmaCache     WFirmaCache[]
  apiCredentials  UserApiCredentials?
  employees       Employee[]
  ksefConfig        KSeFConfig?
  ksefCertificates  KSeFCertificate[]
  ksefSessions      KSeFSession[]
  ksefInvoices      KSeFInvoiceStatus[]
  ksefContractors   KSeFContractor[]
  auditLogs         AuditLog[]
  aiMemories        AIMemory[]
  aiToolUsage       AIToolUsage[]
  telegramLink      TelegramLink?
  referralsMade     Referral[] @relation("referrals_made")
  referredBy        Referral?  @relation("referred_by")
  promptShortcuts      UserPromptShortcut[]
  createdOrgShortcuts  OrgPromptShortcut[] @relation("OrgShortcutCreator")
  aiBudgetConnection   AiBudgetConnection?

  @@index([email])
  @@index([googleId])
  @@index([githubId])
  @@index([createdAt])
  @@index([stripeCustomerId])
  @@index([subscriptionPlan])
  @@index([organizationId])
  @@index([referralCode])
  @@map("users")
}

// ============================================
// REFERRAL PROGRAM
// ============================================

model Referral {
  id             String         @id @default(uuid()) @db.Uuid
  referrerUserId String         @db.Uuid
  referredUserId String?        @unique @db.Uuid
  referralCode   String         // snapshot of code used
  status         ReferralStatus @default(pending)
  rewardGranted  Boolean        @default(false)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  convertedAt    DateTime?

  referrer       User           @relation("referrals_made", fields: [referrerUserId], references: [id])
  referred       User?          @relation("referred_by", fields: [referredUserId], references: [id])

  @@index([referrerUserId])
  @@map("referrals")
}

// ============================================
// USER API CREDENTIALS
// ============================================

model UserApiCredentials {
  id                    String   @id @default(uuid()) @db.Uuid
  userId                String   @unique @db.Uuid

  // wFirma credentials (encrypted JSON: {ciphertext, iv, tag})
  wfirmaEnabled         Boolean  @default(false)
  wfirmaAccessKey       String?  @db.Text
  wfirmaSecretKey       String?  @db.Text
  wfirmaCompanyId       String?  @db.Text

  // LLM Provider credentials
  llmProvider           String?  // 'openai' | 'google' | null (use app default)
  llmApiKey             String?  @db.Text
  llmModel              String?  // e.g., 'gpt-4o', 'gemini-2.5-flash'

  // Metadata
  wfirmaLastValidated   DateTime?
  llmLastValidated      DateTime?

  // Timestamps
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  // Relations
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_api_credentials")
}

// ============================================
// AI CONVERSATIONS
// ============================================

model AIConversation {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid

  // Conversation details
  title       String
  topic       String?

  // Messages history
  messages    Json     @db.JsonB

  // LangGraph state
  graphState  Json?    @db.JsonB

  // Shared conversation support
  organizationId String?  @db.Uuid
  isShared       Boolean  @default(false)
  sharedAt       DateTime?

  // True once a private / other-business AI Budget answer entered the thread
  containsPrivateAiBudgetData Boolean @default(false)

  // Timestamps
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  // Relations
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([organizationId, isShared, createdAt])
  @@map("ai_conversations")
}

// ============================================
// TELEGRAM LINK
// ============================================

model TelegramLink {
  id                   String   @id @default(uuid()) @db.Uuid
  userId               String   @unique @db.Uuid
  telegramUserId       String   @unique // Telegram numeric ID
  telegramUsername      String?
  telegramFirstName    String?
  activeConversationId String?  @db.Uuid // current conversation
  linkedAt             DateTime @default(now())

  // Tax deadline reminder preferences
  reminderEnabled  Boolean @default(true) // send proactive tax deadline reminders
  reminderLeadDays Int     @default(3)    // days before deadline to remind (1, 3, or 7)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([telegramUserId])
  @@map("telegram_links")
}

// ============================================
// WFIRMA CACHE
// ============================================

model WFirmaCache {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @db.Uuid

  // Type of cached data
  dataType      String   // company, contractor, invoice, financial

  // ID of object in wFirma
  wfirmaId      String

  // Cached data
  data          Json     @db.JsonB

  // Cache metadata
  cachedAt      DateTime @default(now())
  expiresAt     DateTime
  isValid       Boolean  @default(true)

  // Relations
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dataType, wfirmaId])
  @@index([userId, dataType])
  @@index([expiresAt])
  @@index([isValid])
  @@map("wfirma_cache")
}

// ============================================
// HR & PAYROLL
// ============================================

model Employee {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @db.Uuid
  firstName     String
  lastName      String
  pesel         String?
  nip           String?
  dateOfBirth   DateTime?
  email         String?
  phone         String?
  street        String?
  city          String?
  zip           String?
  country       String    @default("PL")
  bankAccount   String?
  taxOffice     String?
  notes         String?
  isActive      Boolean   @default(true)
  hiredAt       DateTime?
  firedAt       DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  // Relations
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  contracts     EmploymentContract[]
  payrolls      PayrollRecord[]
  absences      Absence[]

  @@index([userId])
  @@index([userId, isActive])
  @@map("employees")
}

model EmploymentContract {
  id                String          @id @default(uuid()) @db.Uuid
  employeeId        String          @db.Uuid
  type              PaymentType
  status            ContractStatus  @default(draft)
  position          String?
  department        String?
  startDate         DateTime
  endDate           DateTime?
  baseSalaryGross   Decimal         @db.Decimal(12, 2)
  workHoursPerWeek  Decimal?        @db.Decimal(4, 1)
  costDeductionRate Decimal?        @db.Decimal(5, 2)
  notes             String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  // Relations
  employee          Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  payrolls          PayrollRecord[]

  @@index([employeeId])
  @@index([employeeId, status])
  @@map("employment_contracts")
}

model PayrollRecord {
  id              String    @id @default(uuid()) @db.Uuid
  employeeId      String    @db.Uuid
  contractId      String    @db.Uuid
  period          String

  // Gross
  grossAmount     Decimal   @db.Decimal(12, 2)
  bonuses         Decimal   @default(0) @db.Decimal(12, 2)
  deductions      Decimal   @default(0) @db.Decimal(12, 2)

  // ZUS employee side
  zusEmerytalne   Decimal   @default(0) @db.Decimal(12, 2)
  zusRentowe      Decimal   @default(0) @db.Decimal(12, 2)
  zusChorobowe    Decimal   @default(0) @db.Decimal(12, 2)
  zusZdrowotne    Decimal   @default(0) @db.Decimal(12, 2)

  // ZUS employer side
  zusEmerytalneEmployer  Decimal @default(0) @db.Decimal(12, 2)
  zusRentoweEmployer     Decimal @default(0) @db.Decimal(12, 2)
  zusWypadkowe           Decimal @default(0) @db.Decimal(12, 2)
  zusFP                  Decimal @default(0) @db.Decimal(12, 2)
  zusFGSP                Decimal @default(0) @db.Decimal(12, 2)

  // Tax
  taxBase         Decimal   @default(0) @db.Decimal(12, 2)
  incomeTax       Decimal   @default(0) @db.Decimal(12, 2)

  // Net
  netAmount       Decimal   @db.Decimal(12, 2)

  // Total employer cost
  totalEmployerCost Decimal @db.Decimal(12, 2)

  paidAt          DateTime?
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  employee        Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  contract        EmploymentContract @relation(fields: [contractId], references: [id])

  @@unique([employeeId, contractId, period])
  @@index([employeeId])
  @@index([period])
  @@map("payroll_records")
}

model Absence {
  id            String      @id @default(uuid()) @db.Uuid
  employeeId    String      @db.Uuid
  type          AbsenceType
  startDate     DateTime
  endDate       DateTime
  businessDays  Int
  notes         String?
  approved      Boolean     @default(false)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  // Relations
  employee      Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([employeeId, startDate, endDate])
  @@map("absences")
}

// ============================================
// KSEF (Polish National e-Invoice System)
// ============================================

model KSeFConfig {
  id                String          @id @default(uuid()) @db.Uuid
  userId            String          @unique @db.Uuid
  preferredAdapter  KSeFAdapterType @default(wfirma)
  autoSendEnabled   Boolean         @default(false)
  autoSendOnCreate  Boolean         @default(false)
  environment       String          @default("test")
  defaultCertId     String?         @db.Uuid
  notifyOnAccepted  Boolean         @default(true)
  notifyOnRejected  Boolean         @default(true)
  notificationEmail String?
  ksefToken         String?         @db.Text // Autoryzacyjny token from KSeF portal (encrypted in future)
  ksefNip           String?                  // NIP/identifier for KSeF session
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("ksef_config")
}

model KSeFCertificate {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @db.Uuid
  certificateData String   @db.Text
  password        String?  @db.Text
  subject         String
  issuer          String
  serialNumber    String
  validFrom       DateTime
  validUntil      DateTime
  isActive        Boolean  @default(true)
  isDefault       Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions        KSeFSession[]

  @@index([userId])
  @@index([validUntil])
  @@map("ksef_certificates")
}

model KSeFSession {
  id              String            @id @default(uuid()) @db.Uuid
  userId          String            @db.Uuid
  sessionToken    String            @db.Text
  certificateId   String?           @db.Uuid
  status          KSeFSessionStatus @default(active)
  initiatedAt     DateTime          @default(now())
  expiresAt       DateTime
  terminatedAt    DateTime?
  environment     String            @default("test")
  lastUsedAt      DateTime          @default(now())
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  certificate     KSeFCertificate?  @relation(fields: [certificateId], references: [id], onDelete: SetNull)
  invoices        KSeFInvoiceStatus[]

  @@index([userId])
  @@index([expiresAt])
  @@map("ksef_sessions")
}

model KSeFInvoiceStatus {
  id                  String                @id @default(uuid()) @db.Uuid
  userId              String                @db.Uuid
  wfirmaInvoiceId     String?
  ksefReferenceNumber String?               @unique
  ksefInvoiceNumber   String?
  ksefSessionRef      String?               // KSeF session reference (e.g. 20260218-SO-...) for status polling
  contractorName      String?               // Contractor/counterparty name (for display in lists)
  contractorNip       String?               // Contractor NIP (for incoming invoice matching)
  totalGross          Decimal?              @db.Decimal(12, 2) // Total gross amount
  currency            String?               @default("PLN")    // Currency code
  invoiceDate         DateTime?             // Invoice issue date from the document
  status              KSeFInvoiceStatusEnum @default(pending)
  adapter             KSeFAdapterType       @default(wfirma)
  direction           String                @default("sent")
  sessionId           String?               @db.Uuid
  upoDownloaded       Boolean               @default(false)
  upoContent          Bytes?
  upoDownloadedAt     DateTime?
  sentAt              DateTime?
  acceptedAt          DateTime?
  rejectedAt          DateTime?
  invoicePayload      Json?                 // Full FA(3) invoice data (stored for direct adapter invoices to enable copy)
  errorCode           String?
  errorMessage        String?               @db.Text
  retryCount          Int                   @default(0)
  lastRetryAt         DateTime?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  user                User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  session             KSeFSession?          @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([wfirmaInvoiceId])
  @@index([status])
  @@index([sentAt])
  @@index([userId, status])
  @@index([userId, direction])
  @@map("ksef_invoice_status")
}

model KSeFContractor {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  name      String
  nip       String?
  email     String?
  street    String?
  city      String?
  zip       String?
  country   String   @default("PL")
  source    String   @default("local") // 'local' | 'wfirma' | 'company'
  wfirmaId  String?  // null for local-only entries

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, wfirmaId])
  @@index([userId])
  @@index([userId, source])
  @@map("ksef_contractors")
}

// ============================================
// HELP TOPICS (Multilingual Documentation)
// ============================================

model HelpTopic {
  id          String   @id @default(cuid())
  slug        String   @unique // e.g., "getting-started-welcome"
  category    String   // e.g., "gettingStarted", "aiChat", "invoices"

  // Multilingual content
  titlePl     String
  titleEn     String
  titleRu     String
  contentPl   String   @db.Text
  contentEn   String   @db.Text
  contentRu   String   @db.Text

  // Search optimization
  searchKeywordsPl String[] // For better search results
  searchKeywordsEn String[]
  searchKeywordsRu String[]

  // Organization
  order       Int      @default(0) // Display order within category
  isFeatured  Boolean  @default(false)
  isPublished Boolean  @default(true)

  // Metadata
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@index([isPublished])
  @@index([slug])
  @@map("help_topics")
}

// ============================================
// AUDIT LOG
// ============================================

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @db.Uuid
  action    String
  entity    String
  entityId  String?
  changes   Json?    @db.JsonB
  ip        String?
  userAgent String?  @db.Text
  createdAt DateTime @default(now())

  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([entity])
  @@index([action])
  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([entity, createdAt])
  @@map("audit_logs")
}

// ============================================
// AI CONTEXT MEMORY
// ============================================

model AIMemory {
  id              String           @id @default(uuid()) @db.Uuid
  userId          String           @db.Uuid

  // Memory content
  category        AIMemoryCategory
  source          AIMemorySource   @default(implicit)
  key             String           // e.g. "frequent_contractor:12345"
  value           String           @db.Text
  metadata        Json?            @db.JsonB

  // Confidence and lifecycle
  confidence      Float            @default(0.5)
  accessCount     Int              @default(1)
  lastAccessedAt  DateTime         @default(now())

  // Source tracking
  conversationId  String?          @db.Uuid

  // User control
  isPinned        Boolean          @default(false)
  isHidden        Boolean          @default(false)

  // Timestamps
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  // Relations
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, category, key])
  @@index([userId, category])
  @@index([userId, isHidden])
  @@map("ai_memories")
}

// ============================================
// PROMPT SHORTCUTS
// ============================================

model UserPromptShortcut {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  label     String   @db.VarChar(100)
  prompt    String   @db.Text
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, sortOrder])
  @@map("user_prompt_shortcuts")
}

model OrgPromptShortcut {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  label          String       @db.VarChar(100)
  prompt         String       @db.Text
  sortOrder      Int          @default(0)
  createdBy      String       @db.Uuid
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  creator        User         @relation("OrgShortcutCreator", fields: [createdBy], references: [id])

  @@index([organizationId, sortOrder])
  @@map("org_prompt_shortcuts")
}

model AIToolUsage {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @db.Uuid

  toolName        String
  arguments       Json?    @db.JsonB
  conversationId  String?  @db.Uuid

  createdAt       DateTime @default(now())

  // Relations
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, toolName])
  @@index([userId, createdAt])
  @@map("ai_tool_usage")
}

// ============================================
// AI BUDGET INTEGRATION
// ============================================

enum AiBudgetConnectionStatus {
  active
  needs_reconnect
  revoked
}

enum AiBudgetLabel {
  company
  other_business
  private
}

enum AiBudgetLabelSource {
  auto
  manual
}

model AiBudgetConnection {
  id                   String                   @id @default(uuid()) @db.Uuid
  userId               String                   @unique @db.Uuid
  accessTokenEnc       String?                  @db.Text
  refreshTokenEnc      String?                  @db.Text
  accessTokenExpiresAt DateTime?
  scope                String?
  status               AiBudgetConnectionStatus @default(active)
  statusChangedAt      DateTime                 @default(now())
  needsCompanyChoice   Boolean                  @default(false)
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt

  user     User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  accounts AiBudgetAccount[]

  @@map("ai_budget_connections")
}

model AiBudgetAccount {
  id             String              @id @default(uuid()) @db.Uuid
  connectionId   String              @db.Uuid
  userId         String              @db.Uuid
  externalId     String
  name           String
  type           String
  currency       String              @db.VarChar(3)
  access         String
  active         Boolean             @default(true)
  inactiveReason String?
  label          AiBudgetLabel
  labelSource    AiBudgetLabelSource @default(auto)
  syncCursor     String?             @db.Text
  syncGeneration Int                 @default(0)
  lastSyncedAt   DateTime?
  lastSyncError  String?
  fullResyncAt   DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  connection AiBudgetConnection                  @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  expenses   AiBudgetExpense[]
  dismissals AiBudgetReconciliationDismissal[]

  @@unique([connectionId, externalId])
  @@index([userId])
  @@map("ai_budget_accounts")
}

// Company account mirror only; private and other-business data is never stored here.
model AiBudgetExpense {
  id                String   @id @default(uuid()) @db.Uuid
  accountId         String   @db.Uuid
  externalId        String
  amount            Decimal  @db.Decimal(14, 2)
  currency          String   @db.VarChar(3)
  date              DateTime @db.Date
  categoryId        String?
  categorySplits    Json     @default("[]") @db.JsonB
  merchant          String?
  description       String?
  isDebt            Boolean  @default(false)
  isSplitReceivable Boolean  @default(false)
  remoteUpdatedAt   DateTime
  syncGeneration    Int      @default(0)

  account AiBudgetAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, externalId])
  @@index([accountId, date])
  @@map("ai_budget_expenses")
}

model AiBudgetReconciliationDismissal {
  id                String   @id @default(uuid()) @db.Uuid
  accountId         String   @db.Uuid
  externalExpenseId String
  reason            String?
  createdAt         DateTime @default(now())

  account AiBudgetAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, externalExpenseId])
  @@map("ai_budget_reconciliation_dismissals")
}
