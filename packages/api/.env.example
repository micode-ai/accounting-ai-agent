#Database
DATABASE_URL=postgresql://user:password@localhost:5432/accounting_db

#Redis
REDIS_URL=redis://localhost:6379

# JWT (REQUIRED - generate secure secrets with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_SECRET=your_super_secret_key_min_32_chars_long
JWT_EXPIRY=15m
JWT_REFRESH_SECRET=your_refresh_secret_key_min_32_chars_long
REFRESH_TOKEN_EXPIRY=7d

#OAuth
GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxx

# URLs (CORS_ORIGIN is REQUIRED in production)
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:3001
CORS_ORIGIN=http://localhost:3000

#Node
NODE_ENV=development
PORT=3001

#Security
SESSION_SECRET=your_session_secret_key_min_32_chars

#Credentials Encryption (generate with: openssl rand -hex 32)
CREDENTIALS_ENCRYPTION_KEY=your_64_char_hex_string_for_aes256_encryption

#Logging
LOG_LEVEL=info

#wFirma API
WFIRMA_ACCESS_KEY=your_wfirma_access_key_here
WFIRMA_SECRET_KEY=your_wfirma_secret_key_here
WFIRMA_APP_KEY=your_wfirma_app_key_here
WFIRMA_API_URL=https://api2.wfirma.pl
WFIRMA_COMPANY_ID=your_company_id

# AI Budget Assistant integration (optional; hidden unless id, secret, BACKEND_URL, FRONTEND_URL and CREDENTIALS_ENCRYPTION_KEY are set).
# Register the app in AI Budget (Settings > Developers, confidential client) with redirect URI
# ${BACKEND_URL}/api/integrations/ai-budget/callback (prod: https://api.eksiegowyai.pl/api/integrations/ai-budget/callback). Needs Redis >= 6.2.
AI_BUDGET_CLIENT_ID=
AI_BUDGET_CLIENT_SECRET=
AI_BUDGET_API_URL=https://api.ai-budget.pl
AI_BUDGET_AUTHORIZE_URL=https://app.ai-budget.pl/authorize

# GUS BIR1.1 (REGON) — Polish company directory by NIP
# Free registration at https://api.stat.gov.pl/Home/RegonApi
# Without this key the service falls back to the public TEST environment,
# which only knows a handful of canned NIPs (useless in production).
GUS_API_KEY=

#LLM Configuration (Database-only storage, auto-provisioned for PRO users)
# Default provider, model and key used for PRO users who don't provide their own
DEFAULT_LLM_PROVIDER=openai
DEFAULT_LLM_API_KEY=sk-xxx
DEFAULT_LLM_MODEL=gpt-4o

# Options for DEFAULT_LLM_PROVIDER: openai, google
# Examples:
#   OpenAI:  DEFAULT_LLM_PROVIDER=openai   DEFAULT_LLM_API_KEY=sk-xxx        DEFAULT_LLM_MODEL=gpt-4o
#   Google:  DEFAULT_LLM_PROVIDER=google   DEFAULT_LLM_API_KEY=AIzaSy-xxx    DEFAULT_LLM_MODEL=gemini-2.5-flash
# Get Google API Key from: https://aistudio.google.com/app/apikey

#LangSmith (tracing & cost tracking)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=lsv2_pt_xxx
LANGCHAIN_PROJECT=accounting-ai-agent

#Telegram Notifications
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# Monitoring & alerts
SENTRY_DSN=
APP_VERSION=

# Dedicated wFirma health probe credentials (decoupled from per-user data)
WFIRMA_HEALTH_API_KEY=
WFIRMA_HEALTH_COMPANY_ID=
