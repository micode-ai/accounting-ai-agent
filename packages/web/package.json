{
  "name": "@accounting-ai-agent/web",
  "version": "1.1.0",
  "description": "Frontend приложение для AI Agent бухгалтерии",
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=\"--max-old-space-size=4096\" next dev -p 3010",
    "build": "cross-env NODE_OPTIONS=\"--max-old-space-size=4096\" next build",
    "start": "next start",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:e2e": "playwright test tests/e2e/auth tests/e2e/chat tests/e2e/subscription tests/e2e/admin tests/e2e/profile tests/e2e/i18n tests/e2e/guide tests/e2e/integrations",
    "test:e2e:ai-tools": "playwright test tests/e2e/ai-tools",
    "test:e2e:all": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:ci": "jest --ci --coverage --watchAll=false",
    "test:all": "npm run test && npm run test:e2e",
    "lint": "eslint . --ext .ts,.tsx --fix --max-warnings 20",
    "lint:check": "eslint . --ext .ts,.tsx --max-warnings 20",
    "clean": "rm -rf .next out",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test-storybook": "test-storybook",
    "test-storybook:ci": "concurrently -k -s first -n \"SB,TEST\" -c \"magenta,blue\" \"http-server storybook-static --port 6006 --silent\" \"wait-on tcp:6006 && test-storybook\"",
    "chromatic": "chromatic --exit-zero-on-changes"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.3.4",
    "@react-oauth/google": "^0.12.1",
    "@sentry/nextjs": "^10.50.0",
    "@tailwindcss/typography": "^0.5.16",
    "@tanstack/react-query": "^5.14.2",
    "axios": "^1.6.2",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.0.0",
    "gray-matter": "^4.0.3",
    "lucide-react": "^0.460.0",
    "next": "^15.0.0",
    "next-intl": "^3.5.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.49.2",
    "react-markdown": "^9.0.3",
    "react-smooth": "^4.0.4",
    "recharts": "^2.12.7",
    "recharts-scale": "^0.4.5",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^2.2.0",
    "tailwindcss": "^3.4.19",
    "zod": "^3.22.4",
    "zustand": "^4.4.7"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^3.2.6",
    "@playwright/test": "^1.40.1",
    "@storybook/addon-a11y": "^8.6.15",
    "@storybook/addon-essentials": "^8.6.15",
    "@storybook/addon-interactions": "^8.6.15",
    "@storybook/addon-onboarding": "^8.6.15",
    "@storybook/addon-themes": "^8.6.15",
    "@storybook/blocks": "^8.6.15",
    "@storybook/react": "^8.6.15",
    "@storybook/react-vite": "^8.6.15",
    "@storybook/test": "^8.6.15",
    "@storybook/test-runner": "^0.21.0",
    "@testing-library/jest-dom": "^6.1.5",
    "@testing-library/react": "^16.0.0",
    "@types/jest": "^29.5.11",
    "@types/node": "^20.10.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "autoprefixer": "^10.4.16",
    "chromatic": "^11.5.4",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "dotenv": "^16.6.1",
    "eslint": "^8.56.0",
    "eslint-config-next": "^15.0.0",
    "http-server": "^14.1.1",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "postcss": "^8.4.32",
    "storybook": "^8.6.15",
    "typescript": "^5.3.3",
    "vite": "^6.0.0",
    "wait-on": "^7.2.0"
  }
}
